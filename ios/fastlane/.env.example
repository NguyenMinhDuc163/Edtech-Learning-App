# Local fastlane .env
# Copy this file to ios/fastlane/.env for local TestFlight upload.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_KEY_FILEPATH=./fastlane/AuthKey_XXXXXXXXXX.p8
IOS_TEAM_ID=Q236Z72BGN
MATCH_GIT_URL=https://github.com/NguyenMinhDuc163/apple-signing.git
MATCH_PASSWORD=
MATCH_GIT_BASIC_AUTHORIZATION=

# GitHub Actions repository secrets used by
# .github/workflows/reusable-ios-testflight.yml.
# APP_STORE_CONNECT_API_KEY_P8 contains the raw .p8 content. MATCH_GIT_BASIC_AUTHORIZATION
# is Base64("NguyenMinhDuc163:PAT"), not a raw PAT.
#
# APP_STORE_CONNECT_KEY_ID=
# APP_STORE_CONNECT_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_P8=
# IOS_TEAM_ID=Q236Z72BGN
# MATCH_GIT_URL=https://github.com/NguyenMinhDuc163/apple-signing.git
# MATCH_PASSWORD=
# MATCH_GIT_BASIC_AUTHORIZATION=
